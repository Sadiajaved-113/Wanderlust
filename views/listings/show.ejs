<% layout("layouts/boilerplate") -%>
<body>
  <div class="row ">
    <div class="col-8 offset-2">

      <div class="col-8 offset-2 mt-3">
         <h4><b><%=listing.title  %></b></h4>
         
      </div>
     
      <div class="card col-6 offset-2 listing-card">
        <img src="<%= listing.image.url %>"class="card-img-top show-img" alt="listing_image">
  <div class="card-body">
    <p class="card-text">
      <!-- <b><%=listing.title  %></b> <br> -->
       <i>Owned By <%= listing.owner ? listing.owner.username : "Unknown" %></i>

       <br>
      
      <p><%=listing.description %></p>
      <%=listing.price  %><br>
      <%=listing.location  %><br>
      <%=listing.country  %><br>
    </p>
  </div>
  
      </div>
      

     <% if(currUser && currUser._id.equals(listing.owner._id)){ %>

   
     <div class="btns" style="margin-bottom: 80px">
        <a href="/listing/<%= listing._id %>/edit" class="btn btn-dark col-4 edit-btn"  >Edit </a>
        <form method="POST" action="/listing/<%= listing._id %>?_method=DELETE" >
         <button class="btn btn-dark">Delete </button>
      </form>
     </div>
    <% } %>
      
      </div>
     <hr class="form">

    

    
      <div>
           <% if(currUser){ %>
           <h3>Leave a Review</h3>
           <form action= "/listings/<%=listing.id%>/reviews" method ="POST" novalidate class="form needs-validation">
              <!-- <div class="mt-3">
                <label for="rating" class="form-label">Rating</label>
                <input type="range" min="1" max="4" id="rating" name="review[rating]" class="form-range">
              </div> -->
              <div class="mt-3">
                 <label for="rating" class="form-label">Rating</label>
              <fieldset class="starability-slot">
               
           
           <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
           <input type="radio" id="first-rate1" name="review[rating]" value="1" />
           <label for="first-rate1" title="Terrible">1 star</label>
           <input type="radio" id="first-rate2" name="review[rating]" value="2" />
           <label for="first-rate2" title="Not good">2 stars</label>
           <input type="radio" id="first-rate3" name="review[rating]" value="3" />
           <label for="first-rate3" title="Average">3 stars</label>
           <input type="radio" id="first-rate4" name="review[rating]" value="4" />
           <label for="first-rate4" title="Very good">4 stars</label>
           <input type="radio" id="first-rate4" name="review[rating]" value="5" />
           <label for="first-rate4" title="Very wounderful">5 stars</label>
           </fieldset>
           </div>
              <div class="mt-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required ></textarea>
                <div class="invalid-feedback">Please add some comments for reviews</div>
              </div>
              <button class="btn btn-outline-dark mt-3">Submit</button>
           </form>
       <% } %>
           <p class="form pl-3"><b>All Reviews</b></p>
         
          <div class="row form">

         
             <% for(review of listing.reviews){ %>
                <div class="card col-5 ms-3 mb-3">
                   <div class="card-body-1">
                   <h5 class="card-title">@<%=review.author.username%></h5>
                   <p class="starability-result card-text" data-rating= <%=review.rating%>>
                    <p class="card-text"> <%=review.comment%> </p>
                    <!-- <p class="card-text"> <%=review.rating%> stars</p> -->
                     
                    
                     </p>
                </div>
                <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                 <button class="btn btn-sm btn-dark">Delete</button>
                </form>
                </div>
             
             <% } %>
           </div>
      </div>
 
  </div>
</body>
