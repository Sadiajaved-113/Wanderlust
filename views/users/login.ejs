<% layout("layouts/boilerplate") -%>

   <h2 class="col-6 offset-3 mt-3">Login on wanderlust</h2>
   <div class="col-6 offset-3">
      <form action="/login" method="POST" class="needs-validation" novalidate>
           <div class="form-1">
           <label for="username" class="form-label ">Username</label>
           <input name="username"
            id="username"
            type="text"
            class="form-control"
            autocomplete="off"
            required>
        </div>



        <div class="form-1">
           <label for="password" class="form-label ">Password</label>
           <input name="password"
            id="password"
            type="password"
            class="form-control"
            autocomplete="new-password"
            required>
          
        </div>

        <button class="form-3 btn btn-success">Login</button>
      </form>
  </div>
